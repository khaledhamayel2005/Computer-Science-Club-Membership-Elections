rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /admins/{uid} {
      allow read: if isAdmin() && request.auth.uid == uid;
      allow write: if false;
    }

    match /elections/{electionId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'cohort', 'registrationOpen', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.cohort is string
        && request.resource.data.registrationOpen is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /participants/{participantId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && participantId == request.resource.data.electionId + '__' + request.resource.data.normalizedStudentId
        && request.resource.data.keys().hasOnly(['electionId','studentName','studentId','normalizedStudentId','registeredAt','registeredBy','registeredByName','status','updatedAt'])
        && request.resource.data.registeredBy == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.registeredAt is timestamp;
      allow update: if isAdmin()
        && request.resource.data.electionId == resource.data.electionId
        && request.resource.data.registeredBy == resource.data.registeredBy
        && request.resource.data.registeredAt == resource.data.registeredAt
        && request.resource.data.status in ['active', 'void', 'corrected'];
      allow delete: if false;
    }

    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['electionId','participantId','action','before','after','administratorId','administratorName','reason','createdAt'])
        && request.resource.data.administratorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.reason is string;
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
